{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":label(dependencies)"
  ],
  "timezone": "America/Detroit",
  "github-actions": {
    "groupName": "github-actions",
    "automerge": true,
    "schedule": ["* 0-6 12 * *"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-6 5 * *"]
    },
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)[\\w-]*requirements([-.]\\w+)?\\.(txt|pip)$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchFileNames": ["//[\\w-]*docs?/.*/?requirements([-.]\\w+)?\\.(txt|pip)$/$/"],
      "schedule": ["* 0-6 5 3,6,9,12 *"]
    }
  ]
}
